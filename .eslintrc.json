{
    "extends": [
        "next/core-web-vitals",
        "plugin:@typescript-eslint/recommended"
    ],
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "prefer-const": "off",
        "next/next/no-img-element": "warn",
        "jsx-a11y/alt-text": "warn"
    }
}